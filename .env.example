# Copy this file to .env and replace every placeholder value.
# Never commit the real .env file.

NODE_ENV=development

# Local PostgreSQL (managed in pgAdmin). Docker Compose below is optional.
# Two roles: smartdepo_owner runs migrations and owns the tables; smartdepo_app runs the API and
# tests (not a superuser, no BYPASSRLS) so row-level security applies.
# Two databases: smartdepo (development) and smartdepo_test (tests, must end with _test).
DATABASE_URL="postgresql://smartdepo_app:replace-with-app-password@localhost:5432/smartdepo?schema=public"
MIGRATION_DATABASE_URL="postgresql://smartdepo_owner:replace-with-owner-password@localhost:5432/smartdepo?schema=public"
TEST_DATABASE_URL="postgresql://smartdepo_app:replace-with-app-password@localhost:5432/smartdepo_test?schema=public"

# Optional Docker Compose database (not used by the default local setup)
POSTGRES_DB=smartdepo
POSTGRES_USER=smartdepo
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Optional. Swagger is enabled outside production and disabled in production by default.
# Set true to expose /api/docs in production, or false to hide it in development.
# SWAGGER_ENABLED=true

# Web
# The browser calls the Next.js rewrite at /api/v1; the Next server proxies it to the API.
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=http://localhost:3001
# Optional: used by the Next.js route handlers when the API is not on localhost:3001.
# API_INTERNAL_URL=http://localhost:3001

# Auth (JWT signing secrets, used from Phase 2 onward)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Platform admin seed (pnpm --filter api seed:platform-admin). Use fake local credentials only.
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_EMAIL=platform-admin@example.com
PLATFORM_ADMIN_PHONE=
PLATFORM_ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
